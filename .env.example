# Injected by the host in production. Leave blank locally if you use the embedded database.
DATABASE_URL=
VITE_AUTH_ENABLED=true
# Zero-commission UPI checkout (no gateway). Payments land directly in this UPI ID.
# Use a business/merchant VPA where possible; personal VPAs may cap or flag commercial receipts.
ROOMEO_UPI_VPA=
ROOMEO_UPI_NAME=Roomeo

# Public site URL used for canonical links, OG tags and sitemap.xml.
VITE_SITE_URL=https://roomeo.com

# Phone OTP (no Firebase). OTP_PROVIDER = console | sms-gateway | mappstore-whatsapp.
#  - console: prints codes to the server log. Default in dev; refused in production unless OTP_ALLOW_CONSOLE=true.
#  - sms-gateway: self-hosted open-source capcom6/android-sms-gateway (Apache-2.0) on an Android phone with a SIM.
OTP_PROVIDER=console
OTP_ALLOW_CONSOLE=
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=

# DigiLocker (ID verification). The button stays disabled until both are set.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_BASE=https://digilocker.meripehchaan.gov.in/public

# WhatsApp via MappStore BSP (https://mapp.mappstore.in). Key: MappStore → Settings → Developers (scope messages).
# Master switch for WhatsApp notifications (OFF unless "true"). OTP is separately gated by OTP_PROVIDER.
MAPPSTORE_NOTIFY_ENABLED=false
MAPPSTORE_API_KEY=
MAPPSTORE_BASE_URL=https://mapp.mappstore.in/api/v1
# Sending WhatsApp number / phone-number id registered in MappStore.
MAPPSTORE_SENDER=  # currently unused: /messages/send sends from the account's default WABA number
MAPPSTORE_TEMPLATE_LANG=en
# HMAC secret you register for the delivery-status webhook at /api/webhooks/mappstore.
MAPPSTORE_WEBHOOK_SECRET=
# Meta-approved template names (leave blank to disable that message).
# OTP: AUTHENTICATION category, copy-code button. Use with OTP_PROVIDER=mappstore-whatsapp.
MAPPSTORE_TPL_OTP=
# UTILITY: body {{1}} seeker name, {{2}} listing title.
MAPPSTORE_TPL_APPLICATION_RECEIVED=
# UTILITY: body {{1}} listing title.
MAPPSTORE_TPL_APPLICATION_ACCEPTED=
# UTILITY: body {{1}} plan, {{2}} amount, {{3}} payment ref.
MAPPSTORE_TPL_PAYMENT_APPROVED=
